# Checkout context: local-development or remote-production.
WILDEDITOR_ENVIRONMENT=local-development

# Wildeditor does not load one repository-wide environment file.
# Copy and edit the template beside each service you run:
#
#   apps/frontend/.env.development.example -> apps/frontend/.env.local
#   apps/backend/.env.example              -> apps/backend/.env
#   apps/mcp/.env.example                  -> apps/mcp/.env
#   apps/agent/.env.example                -> apps/agent/.env
#
# See docs/configuration.md for variable ownership and security boundaries.
