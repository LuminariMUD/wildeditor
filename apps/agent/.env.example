# Checkout context: local-development or remote-production.
WILDEDITOR_ENVIRONMENT=local-development

HOST=0.0.0.0
PORT=8002
DEBUG=false
LOG_LEVEL=INFO

# Configure at least one provider. Model names must be supported by the
# installed client and your provider account.
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-provider-key
MODEL_NAME=replace-with-supported-model
# ANTHROPIC_API_KEY=replace-with-provider-key
# ANTHROPIC_MODEL=replace-with-supported-model
# DEEPSEEK_API_KEY=replace-with-provider-key
# DEEPSEEK_MODEL=deepseek-chat

# The agent reaches application data only through MCP.
WILDERNESS_MCP_URL=http://localhost:8001
MCP_API_KEY=replace-with-random-mcp-key

STORAGE_BACKEND=memory
REDIS_URL=redis://localhost:6379
SESSION_TTL=86400

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
