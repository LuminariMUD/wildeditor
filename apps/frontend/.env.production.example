# Frontend production build variables. Every value is public after `vite build`.
VITE_API_URL=https://api.example.com/api
VITE_CHAT_API_URL=https://editor.example.com/chat
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-key
VITE_DISABLE_AUTH=false

# Do not add VITE_WILDEDITOR_API_KEY to an untrusted production build. The
# current application will be read-only until browser mutations use validated
# user JWTs; see docs/ongoing-projects/self-hosted-postgres-auth-migration-plan.md.
