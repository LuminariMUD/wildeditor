# Checkout context (not exposed by Vite): local-development or remote-production.
WILDEDITOR_ENVIRONMENT=remote-production

# Frontend production build variables. Every value is public after `vite build`.
VITE_API_URL=https://wildedit-api.luminarimud.com/api
VITE_CHAT_API_URL=https://wildedit-chat.luminarimud.com
VITE_SUPABASE_URL=https://wildedit-auth.luminarimud.com
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_AUTH_CALLBACK_URL=https://wildedit.luminarimud.com/auth/callback
VITE_PASSWORD_RECOVERY_URL=https://wildedit.luminarimud.com/reset-password
VITE_AUTH_SIGNUP_ENABLED=false
VITE_DISABLE_AUTH=false
