# Checkout context (not exposed by Vite): local-development or remote-production.
WILDEDITOR_ENVIRONMENT=local-development

# Copy to apps/frontend/.env.local for local development.
VITE_API_URL=http://localhost:8000/api
VITE_CHAT_API_URL=http://localhost:8002

# Set these when testing the local self-hosted Auth flow.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_PASSWORD_RECOVERY_URL=http://localhost:5173/reset-password
VITE_AUTH_SIGNUP_ENABLED=false

# The bypass is honored only by development builds.
VITE_DISABLE_AUTH=true
