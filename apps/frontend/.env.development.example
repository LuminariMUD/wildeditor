# Copy to apps/frontend/.env.local for local development.
VITE_API_URL=http://localhost:8000/api
VITE_CHAT_API_URL=http://localhost:8002

# Set these when testing the Supabase login flow.
VITE_SUPABASE_URL=https://your-development-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-development-publishable-key

# The bypass is honored only by development builds.
VITE_DISABLE_AUTH=true

# api.ts currently requires a non-empty value for mutations even when the
# local backend has REQUIRE_AUTH=false. Never reuse this value outside local dev.
VITE_WILDEDITOR_API_KEY=local-development-only
