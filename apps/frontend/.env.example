# Frontend variables are embedded in public browser assets by Vite.
# Never place a database credential, service-role key, private API key, or
# signing secret in this file or any VITE_ variable.

VITE_API_URL=http://localhost:8000/api
VITE_CHAT_API_URL=http://localhost:8002

# Supabase browser authentication. The anonymous/publishable key is public by
# design; do not use the Supabase service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-key

# Development builds only. Keep false in deployed environments.
VITE_DISABLE_AUTH=false

# Transitional mutation credential. It is public once built and therefore not
# suitable for an untrusted production deployment. Use only with an isolated
# development backend until user JWT authorization replaces it.
VITE_WILDEDITOR_API_KEY=local-development-only
