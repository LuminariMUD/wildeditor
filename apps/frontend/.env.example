# Checkout context (not exposed by Vite): local-development or remote-production.
WILDEDITOR_ENVIRONMENT=local-development

# Frontend variables are embedded in public browser assets by Vite.
# Never place a database credential, service-role key, private API key, or
# signing secret in this file or any VITE_ variable.

VITE_API_URL=http://localhost:8000/api
VITE_CHAT_API_URL=http://localhost:8002

# Self-hosted Supabase Auth. The publishable key is public by design; do not
# use a secret/service-role key here.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_PASSWORD_RECOVERY_URL=http://localhost:5173/reset-password
VITE_AUTH_SIGNUP_ENABLED=false

# Development builds only. Keep false in deployed environments.
VITE_DISABLE_AUTH=false
