WILDEDITOR_NODE_ENV=development
WILDEDITOR_MCP_PORT=8001
WILDEDITOR_HOST=0.0.0.0
WILDEDITOR_LOG_LEVEL=INFO

# Use independent high-entropy values. The backend key must match the backend.
WILDEDITOR_MCP_KEY=replace-with-random-mcp-key
WILDEDITOR_API_KEY=replace-with-random-backend-key

WILDEDITOR_BACKEND_URL=http://localhost:8000
WILDEDITOR_BACKEND_API_BASE=/api
WILDEDITOR_CORS_ORIGINS=http://localhost:5173

# AI generation is optional. `none` allows non-provider operations; configure
# one provider and replace its placeholders to enable generation.
AI_PROVIDER=none
# OPENAI_API_KEY=replace-with-provider-key
# OPENAI_MODEL=replace-with-supported-model
# ANTHROPIC_API_KEY=replace-with-provider-key
# ANTHROPIC_MODEL=replace-with-supported-model
# DEEPSEEK_API_KEY=replace-with-provider-key
# DEEPSEEK_MODEL=deepseek-chat
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=replace-with-installed-model
