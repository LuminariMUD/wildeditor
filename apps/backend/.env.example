# Checkout context: local-development or remote-production.
WILDEDITOR_ENVIRONMENT=local-development

# Required datastore configuration.
MYSQL_DATABASE_URL=mysql+pymysql://wildeditor_user:replace-me@localhost:3306/luminari_muddev

# Human JWT validation. During cutover, list the managed issuer first and the
# self-hosted issuer second; remove the managed issuer after rollback closes.
WILDEDITOR_AUTH_ISSUERS=http://localhost:54321/auth/v1
# Optional comma-aligned override; otherwise each issuer's JWKS URL is derived.
# WILDEDITOR_AUTH_JWKS_URLS=http://localhost:54321/auth/v1/.well-known/jwks.json
WILDEDITOR_AUTH_AUDIENCE=authenticated
WILDEDITOR_AUTH_ALLOWED_ALGORITHMS=ES256
WILDEDITOR_AUTH_JWKS_CACHE_TTL=300

# Server-only MCP-to-backend Bearer credential. Never expose this to Vite.
WILDEDITOR_BACKEND_SERVICE_KEY=replace-with-random-backend-service-key
REQUIRE_AUTH=true

# Database-component fallback used only when MYSQL_DATABASE_URL is absent.
ENVIRONMENT=development
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=wildeditor_user
# DB_PASSWORD=replace-me
# DB_NAME=luminari_muddev

# Exact comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173

# Backend MCP proxy configuration.
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=replace-with-random-mcp-key
