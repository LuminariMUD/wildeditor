# Required datastore configuration.
MYSQL_DATABASE_URL=mysql+pymysql://wildeditor_user:replace-me@localhost:3306/luminari_muddev

# Backend Bearer authentication. Generate a unique high-entropy value.
WILDEDITOR_API_KEY=replace-with-random-backend-key
REQUIRE_AUTH=true

# Database-component fallback used only when MYSQL_DATABASE_URL is absent.
ENVIRONMENT=development
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=wildeditor_user
# DB_PASSWORD=replace-me
# DB_NAME=luminari_muddev

# Exact comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173

# Backend MCP proxy configuration.
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=replace-with-random-mcp-key
